# 빌드 산출물
/build/

# VM 디스크 이미지 (용량이 커서 커밋하지 않는다)
*.qcow2
*.img
/lab/vm/images/

# Python
__pycache__/
*.pyc

# 편집기
.vscode/
*.swp

# 측정 결과의 파생 파일 (samples.log에서 tg_to_csv.py로 다시 만들 수 있다)
/results/m1/**/samples.csv
/results/m1/**/cg.csv

# 스모크 테스트 결과 (참고용으로만 로컬에 두고 커밋하지 않는다)
/results/m1-smoke/
# 측정 원본(실행별 로그, 프로브 기록 등)은 모두 로컬에만 둔다. 보고서가 직접 싣는 요약표와 그래프만 예외로 추적한다.
# 이미 추적 중인 결과(m0-check, m1, m3)는 영향을 받지 않는다.
/results/*
!/results/m4/
/results/m4/*
!/results/m4/2026-11-13/
/results/m4/2026-11-13/*
!/results/m4/2026-11-13/summary.md
!/results/m4/2026-11-13/summary.json
!/results/m4/2026-11-13/*.svg
