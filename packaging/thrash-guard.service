# thrash-guard 서비스 파일
#
# 설치:
#   install -m 0755 build/glibc/thrash-guard /usr/local/sbin/thrash-guard
#   install -D -m 0644 packaging/thrash-guard.conf /etc/thrash-guard/thrash-guard.conf
#   install -m 0644 packaging/thrash-guard.service /etc/systemd/system/thrash-guard.service
#   systemctl daemon-reload && systemctl enable --now thrash-guard
#
# 처음에는 dry-run(판단만 기록)으로 시작한다. 로그(`journalctl -u thrash-guard`)로 후보와 판단을
# 확인한 뒤 ExecStart의 --dry-run을 --no-dry-run으로 바꿔 실제 종료를 켠다.
# 아래 값은 모두 임시이며 VM 실험으로 확인한다(docs/design/overview.md 4절).

[Unit]
Description=thrash-guard: terminate a culprit cgroup under memory thrashing
Documentation=https://github.com/zie-ning/thrash-guard
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/thrash-guard --config /etc/thrash-guard/thrash-guard.conf --dry-run

# 비정상 종료하면 다시 켠다. 데몬이 죽은 채로 남으면 안전장치가 조용히 사라진다.
# SIGTERM·SIGINT로 정상 종료한 경우(종료 코드 0)는 다시 켜지 않는다.
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

# 자기 보호. 커널 OOM killer가 이 데몬을 고르지 않게 하고(데몬도 시작할 때 스스로 쓴다),
# mlockall이 한도에 막히지 않게 하며, CPU 경쟁이 심해도 먼저 CPU를 받게 한다.
OOMScoreAdjust=-1000
LimitMEMLOCK=infinity
CPUWeight=1000

# 회수 보호(선택): mlockall로 이미 고정되므로 기본은 끈다. 필요하면 데몬의 실제 사용량을 잰 뒤 정한다.
#MemoryLow=16M

# 보안 강화 옵션(ProtectKernelTunables, ProtectSystem=strict 등)은 일부러 쓰지 않는다.
# /sys/fs/cgroup 아래 cgroup.kill에 쓸 수 있어야 하므로 /sys를 읽기 전용으로 만들면 종료가 막힌다.

[Install]
WantedBy=multi-user.target
